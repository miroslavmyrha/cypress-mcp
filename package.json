{
  "name": "@miroslavmyrha/cypress-mcp",
  "version": "0.1.1",
  "description": "MCP server that shows an AI assistant the last cypress run: command log, errors, screenshots and DOM snapshots of failed tests",
  "author": "Miroslav Myrha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miroslavmyrha/cypress-mcp.git"
  },
  "homepage": "https://github.com/miroslavmyrha/cypress-mcp#readme",
  "bugs": {
    "url": "https://github.com/miroslavmyrha/cypress-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "cypress-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/server.js",
    "./plugin": "./dist/plugin/index.js",
    "./support": "./dist/support/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^12.0.0",
    "glob": "^11.0.0",
    "node-html-parser": "^7.0.2",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "cypress": "^13.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "cypress": ">=12.0.0"
  },
  "peerDependenciesMeta": {
    "cypress": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cypress",
    "cypress-run",
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "claude",
    "e2e",
    "testing",
    "ci",
    "debugging"
  ],
  "license": "MIT",
  "packageManager": "bun@1.2.0"
}
